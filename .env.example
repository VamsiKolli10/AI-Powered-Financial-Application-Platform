# ---- Core ----
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_NAME=gateway

# ---- Postgres ----
POSTGRES_USER=finai
POSTGRES_PASSWORD=finai
POSTGRES_DB=finai
DATABASE_URL=postgresql+asyncpg://finai:finai@postgres:5432/finai

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=finai

# ---- LLM ----
OPENAI_API_KEY=sk-replace-me
# Optional: Azure OpenAI, a gateway, or a local model server
# LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_CACHE_TTL_SECONDS=604800
LLM_RATE_LIMIT_PER_MINUTE=120
LLM_ENABLED=true

# ---- Auth ----
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
INTERNAL_SERVICE_TOKEN=dev-internal-token

# ---- Alerting thresholds (Notifications) ----
ANOMALY_ALERT_THRESHOLD=0.8
LARGE_TRANSACTION_THRESHOLD=500
BUDGET_MONTHLY_LIMIT=1500

# ---- Rate limits (per user, per minute) ----
RATE_LIMIT_STANDARD=100
RATE_LIMIT_LLM=20

# ---- Downstream service URLs (gateway) ----
TRANSACTIONS_URL=http://transactions:8000
ASSISTANT_URL=http://assistant:8000
INSIGHTS_URL=http://insights:8000
NOTIFICATIONS_URL=http://notifications:8000
