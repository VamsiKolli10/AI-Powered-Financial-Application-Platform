# ---- Core ----
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_NAME=gateway

# ---- Postgres ----
POSTGRES_USER=finai
POSTGRES_PASSWORD=finai
POSTGRES_DB=finai
DATABASE_URL=postgresql+asyncpg://finai:finai@postgres:5432/finai
# DB_ECHO=false
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Kafka ----
# Set false to run without a broker (no new alerts are created)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=finai
# AWS MSK example: SASL_SSL + SCRAM-SHA-512 (credentials come from Secrets Manager)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---- LLM ----
# This setting also accepts a key from an OpenAI-compatible provider such as OpenRouter or Groq.
OPENAI_API_KEY=
# Optional: an OpenAI-compatible provider, gateway, or local model server
# LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter free tier: use your OpenRouter key above; replace the active values below.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free
# LLM_RATE_LIMIT_PER_MINUTE=10
# Groq free tier: use your Groq key above; replace the active model/rate values below.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_RATE_LIMIT_PER_MINUTE=20
# See docs/CONFIGURATION.md for setup and current provider limits.
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_CACHE_TTL_SECONDS=604800
LLM_RATE_LIMIT_PER_MINUTE=120
# Set true after configuring a valid provider key.
LLM_ENABLED=false

# ---- Auth ----
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
INTERNAL_SERVICE_TOKEN=dev-internal-token

# ---- Alerting thresholds (Notifications) ----
ANOMALY_ALERT_THRESHOLD=0.8
LARGE_TRANSACTION_THRESHOLD=500
BUDGET_MONTHLY_LIMIT=1500

# ---- Rate limits (per user, per minute) ----
RATE_LIMIT_STANDARD=100
RATE_LIMIT_LLM=20

# ---- Downstream service URLs (gateway) ----
TRANSACTIONS_URL=http://transactions:8000
ASSISTANT_URL=http://assistant:8000
INSIGHTS_URL=http://insights:8000
NOTIFICATIONS_URL=http://notifications:8000
